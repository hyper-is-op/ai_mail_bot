# Database (MySQL)
DB_HOST=localhost
DB_USER=mail_ai
DB_PASS=your_strong_db_password
DB_NAME=ai_mail_bot
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password

# Groq LLM API
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.6-27b

# Redis
REDIS_URL=redis://mail_ai_redis:6379/0
REDIS_HISTORY_URL=redis://mail_ai_redis:6379/1

# Encryption Key (Fernet 32-byte base64 key: generate via `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`)
CONNECTOR_SECRET_ENCRYPTION_KEY=your_fernet_key_base64_here

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:1947,http://172.16.3.215:1947
